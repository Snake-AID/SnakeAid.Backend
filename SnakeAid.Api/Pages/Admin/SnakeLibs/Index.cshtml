@page "/admin/snakelibs"
@model SnakeAid.Api.Pages.Admin.SnakeLibs.IndexModel
@{
    ViewData["Title"] = "Snake Library | Admin Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Premium Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="~/SnakeAid.Api.styles.css" rel="stylesheet" />
    <style>
        :root {
            --bg-dark: #020617;
            --bg-panel: rgba(15, 23, 42, 0.65);
            --bg-card: rgba(30, 41, 59, 0.4);
            --border-glass: rgba(255, 255, 255, 0.08);
            --border-active: rgba(59, 130, 246, 0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --accent-red: #f43f5e;
            --accent-purple: #8b5cf6;
            --accent-gold: #f59e0b;
            --glass-blur: 16px;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 0% 0%, rgba(59, 130, 246, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 100% 100%, rgba(139, 92, 246, 0.15) 0%, transparent 40%);
            min-height: 100vh;
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 40px 20px;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4 { font-family: 'Outfit', sans-serif; }

        .container-xl {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* HEADER SECTION */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-glass);
        }

        .header-content h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0;
            background: linear-gradient(to right, #fff, var(--text-muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -1px;
        }

        .header-content p {
            color: var(--text-muted);
            margin: 8px 0 0 0;
            font-size: 1.1rem;
        }

        .header-stats {
            display: flex;
            gap: 24px;
        }

        .stat-item {
            text-align: right;
        }

        .stat-value {
            display: block;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent-blue);
            font-family: 'Outfit', sans-serif;
        }

        .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
        }

        /* DATA TABLE / GRID */
        .catalog-container {
            background: var(--bg-panel);
            backdrop-filter: blur(var(--glass-blur));
            border: 1px solid var(--border-glass);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .modern-table {
            width: 100%;
            border-collapse: collapse;
        }

        .modern-table th {
            padding: 24px;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-glass);
            background: rgba(255, 255, 255, 0.02);
        }

        .modern-table tr {
            transition: all 0.2s ease;
        }

        .modern-table tr:not(.detail-row):hover {
            background: rgba(255, 255, 255, 0.03);
            cursor: pointer;
        }

        .modern-table td {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-glass);
            vertical-align: middle;
        }

        .scientific-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            font-style: italic;
        }

        .common-name {
            font-size: 0.95rem;
            color: var(--text-muted);
            display: block;
            margin-top: 2px;
        }

        /* BADGES */
        .premium-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid transparent;
        }

        .badge-venom {
            background: rgba(244, 63, 94, 0.1);
            color: var(--accent-red);
            border-color: rgba(244, 63, 94, 0.2);
        }

        .badge-non-venom {
            background: rgba(16, 185, 129, 0.1);
            color: var(--accent-green);
            border-color: rgba(16, 185, 129, 0.2);
        }

        .venom-type-pill {
            background: var(--bg-card);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
            border: 1px solid var(--border-glass);
        }

        /* METRICS INDICATORS */
        .metric-indicator {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: var(--bg-card);
            border: 1px solid var(--border-glass);
            font-weight: 700;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        tr:hover .metric-indicator {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
            transform: scale(1.1);
        }

        /* DETAIL VIEW */
        .detail-row {
            display: none;
            background: rgba(0, 0, 0, 0.2);
        }

        .detail-row.is-active {
            display: table-row;
        }

        .detail-card-wrapper {
            padding: 40px;
            animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 40px;
        }

        .detail-image-box {
            aspect-ratio: 1;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-glass);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .detail-image-box i {
            font-size: 4rem;
            color: rgba(255,255,255,0.05);
        }

        .detail-info-box {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .info-section h4 {
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0 0 16px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-section h4::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-glass);
        }

        .tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .meta-pill {
            background: var(--bg-card);
            border: 1px solid var(--border-glass);
            padding: 10px 18px;
            border-radius: 14px;
            font-weight: 500;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .meta-pill i { color: var(--accent-blue); }

        .expand-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        tr.expanded .expand-btn {
            transform: rotate(90deg);
            color: var(--accent-blue);
        }

        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* SCROLLBAR */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }
    </style>
</head>
<body>

<div class="container-xl">
    <header class="page-header">
        <div class="header-content">
            <h1>Snake Catalog</h1>
            <p>Master library of all indexed snake species</p>
        </div>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-label">Total Species</span>
                <span class="stat-value">@Model.Species.Count</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Venomous</span>
                <span class="stat-value" style="color: var(--accent-red)">@Model.Species.Count(s => s.IsVenomous)</span>
            </div>
        </div>
    </header>

    <div class="catalog-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width: 60px"></th>
                    <th>Full Identification</th>
                    <th>Venom Status</th>
                    <th>Primary Agent</th>
                    <th class="text-center">Alt Names</th>
                    <th class="text-center">Media</th>
                    <th class="text-center">Tariffs</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Species)
                {
                    <tr id="row-@s.Id" onclick="toggleSpecies('@s.Id')">
                        <td class="text-center">
                            <button class="expand-btn">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                        <td>
                            <span class="scientific-name">@s.ScientificName</span>
                            <span class="common-name">@(string.IsNullOrWhiteSpace(s.CommonName) ? s.ScientificName : s.CommonName)</span>
                        </td>
                        <td>
                            @if (s.IsVenomous) {
                                <span class="premium-badge badge-venom">
                                    <i class="bi bi-radioactive"></i> Venomous
                                </span>
                            } else {
                                <span class="premium-badge badge-non-venom">
                                    <i class="bi bi-shield-check"></i> Non-Venomous
                                </span>
                            }
                        </td>
                        <td>
                            @if (s.PrimaryVenomType != null) {
                                <span class="venom-type-pill">@s.PrimaryVenomType</span>
                            } else {
                                <span style="color: var(--text-muted)">-</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="metric-indicator">@(s.AlternativeNames?.Count ?? 0)</div>
                        </td>
                        <td class="text-center">
                            <div class="metric-indicator">@(s.LibraryMedias?.Count ?? 0)</div>
                        </td>
                        <td class="text-center">
                            <div class="metric-indicator">@(s.SnakeCatchingTariffs?.Count ?? 0)</div>
                        </td>
                    </tr>
                    <tr id="detail-@s.Id" class="detail-row">
                        <td colspan="7">
                            <div class="detail-card-wrapper">
                                <div class="detail-grid">
                                    <div class="detail-image-box">
                                        <i class="bi bi-image"></i>
                                        <!-- Real media would go here -->
                                    </div>
                                    <div class="detail-info-box">
                                        <div class="info-section">
                                            <h4><i class="bi bi-tags"></i> Alternative Designations</h4>
                                            <div class="tag-cloud">
                                                @if (s.AlternativeNames?.Any() == true) {
                                                    @foreach (var n in s.AlternativeNames) {
                                                        <div class="meta-pill">@n.Name</div>
                                                    }
                                                } else {
                                                    <span style="color: var(--text-muted); font-style: italic;">No regional names indexed</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="info-section">
                                            <h4><i class="bi bi-droplet-half"></i> Venom Analysis</h4>
                                            <div class="tag-cloud">
                                                @if (s.SpeciesVenoms?.Any() == true) {
                                                    @foreach (var v in s.SpeciesVenoms) {
                                                        <div class="meta-pill">
                                                            <i class="bi bi-check2-circle"></i>
                                                            @(v.VenomType?.Name ?? "Unknown Protein")
                                                        </div>
                                                    }
                                                } else {
                                                    <span style="color: var(--text-muted); font-style: italic;">No specific venom profile data</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="info-section">
                                            <h4><i class="bi bi-database-gear"></i> System Metadata</h4>
                                            <div class="tag-cloud">
                                                <div class="meta-pill"><i class="bi bi-hash"></i> ID: @s.Id</div>
                                                <div class="meta-pill"><i class="bi bi-clock"></i> Updated: Just now</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleSpecies(id) {
        const detailRow = document.getElementById(`detail-${id}`);
        const mainRow = document.getElementById(`row-${id}`);
        const isActive = detailRow.classList.contains('is-active');
        
        // Close all others
        document.querySelectorAll('.detail-row').forEach(r => r.classList.remove('is-active'));
        document.querySelectorAll('.modern-table tr').forEach(r => r.classList.remove('expanded'));
        
        if (!isActive) {
            detailRow.classList.add('is-active');
            mainRow.classList.add('expanded');
        }
    }
</script>

</body>
</html>

