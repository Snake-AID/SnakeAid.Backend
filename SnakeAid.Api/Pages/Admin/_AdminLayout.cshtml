<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SnakeAid Admin</title>
    <!-- Premium Typography -->
    <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
            :root {
                --bg-dark: #020617;
                --bg-panel: rgba(15, 23, 42, 0.7);
                --bg-card: rgba(30, 41, 59, 0.5);
                --border-glass: rgba(255, 255, 255, 0.06);
                --text-main: #f8fafc;
                --text-muted: #94a3b8;
                --accent-blue: #3b82f6;
                --accent-green: #10b981;
                --accent-red: #f43f5e;
                --accent-purple: #8b5cf6;
                --accent-gold: #f59e0b;
                --font-main: 'Inter', sans-serif;
                --font-header: 'Outfit', sans-serif;
                --font-mono: 'JetBrains Mono', monospace;
                --glass-blur: 20px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                background-color: var(--bg-dark);
                background-image:
                    radial-gradient(circle at 10% 20%, rgba(244, 63, 94, 0.05) 0%, transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.15) 0%, transparent 40%);
                min-height: 100vh;
                color: var(--text-main);
                font-family: var(--font-main);
                margin: 0;
                padding: 0;
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }

            h1,
            h2,
            h3,
            h4 {
                font-family: var(--font-header);
            }

            /* SHARED PAGE HEADER */
            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
                padding: 20px;
                background: var(--bg-panel);
                backdrop-filter: blur(var(--glass-blur));
                border: 1px solid var(--border-glass);
                border-radius: 28px;
                box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
            }

            .header-title-group h1 {
                font-size: 2.2rem;
                font-weight: 800;
                margin: 0;
                letter-spacing: -1px;
                background: linear-gradient(to right, #fff, var(--text-muted));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .header-title-group p {
                margin: 8px 0 0 0;
                color: var(--text-muted);
                font-size: 1rem;
                font-weight: 500;
            }

            .header-actions {
                display: flex;
                gap: 20px;
                align-items: center;
            }

            .stat-badge {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                background: rgba(255, 255, 255, 0.03);
                padding: 10px 20px;
                border-radius: 16px;
                border: 1px solid var(--border-glass);
            }

            .stat-value {
                font-size: 1.4rem;
                font-weight: 700;
                color: #fff;
                font-family: var(--font-mono);
                line-height: 1;
            }

            .stat-label {
                font-size: 0.7rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 1.5px;
                margin-top: 4px;
            }

            /* NAVBAR */
            .admin-nav {
                position: sticky;
                top: 0;
                z-index: 1000;
                background: rgba(2, 6, 23, 0.8);
                backdrop-filter: blur(20px);
                border-bottom: 1px solid var(--border-glass);
                padding: 0 40px;
                height: 80px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .nav-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-family: var(--font-header);
                font-weight: 800;
                font-size: 1.4rem;
                color: #fff;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-brand i {
                color: var(--accent-red);
                filter: drop-shadow(0 0 8px rgba(244, 63, 94, 0.4));
            }

            .nav-links {
                display: flex;
                gap: 8px;
                background: rgba(255, 255, 255, 0.03);
                padding: 6px;
                border-radius: 14px;
                border: 1px solid var(--border-glass);
            }

            .nav-link {
                padding: 10px 20px;
                border-radius: 10px;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .nav-link:hover {
                color: #fff;
                background: rgba(255, 255, 255, 0.05);
            }

            .nav-link.active {
                background: var(--accent-blue);
                color: #fff;
                box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
            }

            .nav-link.active i {
                color: #fff;
            }

            /* CONTENT */
            .admin-content {
                padding: 20px;
                max-width: 1600px;
                margin: 0 auto;
            }

            /* Responsive */
            @@media (max-width: 768px) {
                .admin-nav {
                    padding: 0 20px;
                    height: auto;
                    padding: 15px 20px;
                    flex-direction: column;
                    gap: 15px;
                }
                .nav-links {
                    width: 100%;
                    justify-content: space-around;
                    font-size: 0.8rem;
                }

                .nav-link {
                    padding: 8px 12px;
                }
                .admin-content {
                    padding: 20px;
                }
            }

            @@keyframes pulse-red {
                0% {
                    box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.4);
                }
                70% {
                    box-shadow: 0 0 0 10px rgba(244, 63, 94, 0);
                }
                100% {
                    box-shadow: 0 0 0 0 rgba(244, 63, 94, 0);
                }
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <nav class="admin-nav">
        <a href="/admin" class="nav-brand">
            <i class="bi bi-shield-lock-fill"></i>
            SnakeAid <span>Admin Hub</span>
        </a>

        <div class="nav-links">
            <a href="/admin/snakelibs"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/snakelibs") ? "active" : "")">
                <i class="bi bi-journal-medical"></i> Species
            </a>
            <a href="/admin/incidents"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/incidents") ? "active" : "")">
                <i class="bi bi-activity"></i> Incidents
            </a>
            <a href="/admin/livetracking"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/livetracking") ? "active" : "")">
                <i class="bi bi-radar"></i> Live Map
            </a>
            <a href="/admin/simulator"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/simulator") ? "active" : "")">
                <i class="bi bi-terminal"></i> Simulator
            </a>
            <a href="/admin/dispatch-operator"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/dispatch-operator") ? "active" : "")">
                <i class="bi bi-broadcast-pin"></i> Operator
            </a>
            <a href="/admin/dispatch-rescuers"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/dispatch-rescuers") ? "active" : "")">
                <i class="bi bi-people"></i> Rescuers
            </a>
            <a href="/admin/otps"
                   class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/otps") ? "active" : "")">
                <i class="bi bi-key-fill"></i> OTP Control
            </a>
        </div>

        <div style="display: flex; gap: 15px; align-items: center;">
            <div style="display: flex; flex-direction: column; align-items: flex-end;">
                <span style="font-size: 0.85rem; font-weight: 700;">Control Center</span>
                <span id="system-time"
                      style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">--:--:--</span>
            </div>
            <div
                style="width: 40px; height: 40px; border-radius: 12px; background: var(--bg-card); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-glass);">
                <i class="bi bi-person-gear" style="color: var(--accent-blue);"></i>
            </div>
        </div>
    </nav>

    <main class="admin-content">
        @RenderBody()
    </main>

    <script>
            function updateTime() {
                const now = new Date();
                const timeStr = now.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
                const el = document.getElementById('system-time');
                if (el) el.innerText = timeStr;
            }
            setInterval(updateTime, 1000);
            updateTime();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
