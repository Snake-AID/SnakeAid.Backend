@page
@model SnakeAid.Api.Pages.Admin.LiveTracking.IndexModel
@{
    ViewData["Title"] = "Live Tracking Monitor (God Mode)";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SnakeAid Admin</title>
    <!-- Modern Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --bg-dark: #0f172a;
            --bg-panel: #1e293b;
            --bg-card: #334155;
            --border-color: #475569;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --accent-yellow: #f59e0b;
            --accent-red: #ef4444;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: var(--font-main);
            overflow-x: hidden;
            margin: 0;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .header h2 {
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header h2 i {
            color: var(--accent-blue);
        }

        .badge-status {
            font-size: 0.9rem;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
            border: 1px solid var(--accent-green);
        }

        .badge-status.disconnected {
            background-color: rgba(239, 68, 68, 0.1) !important;
            color: var(--accent-red) !important;
            border: 1px solid var(--accent-red);
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
        }

        .monitor-layout {
            display: flex;
            gap: 25px;
            height: calc(100vh - 120px);
        }

        /* MAIN AREA */
        .main-area {
            flex: 3;
            background: var(--bg-panel);
            border-radius: 16px;
            padding: 24px;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        h4.section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title span {
            color: var(--text-main);
            background: var(--bg-card);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.9rem;
            margin-left: 8px;
        }

        /* TABS STYLING */
        .custom-tabs {
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
        }

        .custom-tab {
            padding: 10px 20px;
            color: var(--text-muted);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .custom-tab:hover {
            color: var(--text-main);
        }

        .custom-tab.active {
            color: var(--accent-blue);
            border-bottom-color: var(--accent-blue);
        }
        
        .custom-tab.ghost.active {
            color: var(--accent-red);
            border-bottom-color: var(--accent-red);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .rescuers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .rescuer-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .rescuer-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            border-color: #64748b;
        }

        .rescuer-card.pinged {
            border-color: var(--accent-yellow);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
            animation: pulse-yellow 2s infinite;
        }

        .rescuer-card.winner {
            border-color: var(--accent-green);
            background-color: rgba(16, 185, 129, 0.1);
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
        }

        .rescuer-card.taken {
            border-color: var(--border-color);
            opacity: 0.5;
            filter: grayscale(100%);
        }

        .rescuer-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .rescuer-avatar {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent-blue), #2563eb);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);
        }

        .rescuer-info h5 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 600;
        }

        .location-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .loc-pill {
            background: rgba(15, 23, 42, 0.6);
            padding: 6px 12px;
            border-radius: 20px;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
            border: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.3s ease;
        }

        .loc-pill span {
            color: var(--text-main);
            font-weight: 500;
        }
        
        .location-pills.highlight .loc-pill {
            background-color: rgba(59, 130, 246, 0.2);
            border-color: var(--accent-blue);
            color: white;
            box-shadow: inset 0 0 10px rgba(59, 130, 246, 0.2);
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(148, 163, 184, 0.1);
            color: var(--text-muted);
            border: 1px solid rgba(148, 163, 184, 0.2);
            margin-top: 5px;
        }

        .status-badge.idle { background: rgba(148, 163, 184, 0.1); color: var(--text-muted); border-color: rgba(148, 163, 184, 0.3); }
        .status-badge.pinged { background: rgba(245, 158, 11, 0.15); color: var(--accent-yellow); border-color: rgba(245, 158, 11, 0.4); }
        .status-badge.busy { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); border-color: rgba(16, 185, 129, 0.4); }

        /* Ping Timer Circle */
        .ping-timer {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: conic-gradient(var(--accent-blue) var(--ping-progress, 0%), transparent 0);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: auto;
        }

        .ping-timer::before {
            content: '';
            position: absolute;
            width: 18px;
            height: 18px;
            background: var(--bg-card);
            border-radius: 50%;
        }

        .ping-timer i {
            font-size: 0.6rem;
            color: var(--text-muted);
            z-index: 1;
        }
        
        /* Stop animation when ping is old (Flutter hasn't moved 10m) */
        .ping-timer.stale {
            background: rgba(255, 255, 255, 0.05);
        }
        .ping-timer.stale i {
            color: var(--accent-yellow);
        }

        /* SIDEBAR AREA */
        .sidebar-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 25px;
            min-width: 350px;
        }

        .incident-tracker {
            background: linear-gradient(145deg, var(--bg-panel), #151e2d);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .incident-tracker::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 4px;
            background: var(--accent-red);
            box-shadow: 0 0 15px var(--accent-red);
        }

        .incident-title {
            color: var(--accent-red);
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: 0.5px;
        }

        .incident-detail {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .incident-detail strong {
            color: var(--text-main);
            font-family: var(--font-mono);
        }

        .timer-container {
            margin-top: 25px;
            background: var(--bg-dark);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .timer-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .timer-header span.time {
            color: var(--accent-red);
            font-weight: 700;
            font-family: var(--font-mono);
            font-size: 1.1rem;
        }

        .progress-custom {
            height: 8px;
            background: var(--bg-card);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-bar-custom {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-red), #f43f5e);
            border-radius: 4px;
            transition: width 1s linear;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
        }

        .event-console {
            flex: 1;
            background: var(--bg-dark);
            border-radius: 16px;
            padding: 20px;
            font-family: var(--font-mono);
            overflow-y: auto;
            border: 1px solid var(--border-color);
            font-size: 0.85rem;
            line-height: 1.6;
            box-shadow: inset 0 5px 20px rgba(0,0,0,0.5);
        }

        .console-header {
            position: sticky;
            top: -20px;
            background: var(--bg-dark);
            padding-bottom: 10px;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.8rem;
            font-family: var(--font-main);
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .console-entry {
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px dashed rgba(255,255,255,0.05);
            word-break: break-all;
        }

        .console-entry:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .console-entry .time { 
            color: var(--text-muted); 
            font-size: 0.8rem;
            margin-right: 8px;
        }
        
        .console-entry.info { color: #38bdf8; }
        .console-entry.warn { color: var(--accent-yellow); }
        .console-entry.error { color: var(--accent-red); }
        .console-entry.success { color: var(--accent-green); }

        @@keyframes pulse-yellow {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
            70% { box-shadow: 0 0 0 15px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
    </style>
</head>
<body>
    <div class="header" style="margin-top: 0">
        <h2>
            <i class="bi bi-radar"></i> 
            Live Tracking Monitor 
            <span style="font-size: 0.9rem; font-weight: normal; color: var(--text-muted); margin-left: 10px;">God Mode</span>
        </h2>
        <div>
            <span class="badge badge-status bg-success text-white" id="connection-status">Connecting...</span>
        </div>
    </div>

    <div class="monitor-layout">
        <!-- Main Area: Rescuers -->
        <div class="main-area">
            <div class="custom-tabs">
                <div class="custom-tab active" onclick="switchTab('connected')" id="tab-connected">
                    <i class="bi bi-people-fill"></i> Connected <span class="badge bg-secondary rounded-pill" style="margin-left: 5px; font-size: 0.8rem;" id="rescuer-count">0</span>
                </div>
                <div class="custom-tab ghost" onclick="switchTab('ghosts')" id="tab-ghosts">
                    <i class="bi bi-search"></i> Ghost Scanner <span class="badge bg-danger rounded-pill" style="margin-left: 5px; font-size: 0.8rem;" id="ghost-count">0</span>
                </div>
                <div class="custom-tab" onclick="switchTab('all')" id="tab-all">
                    <i class="bi bi-list-ul"></i> All Rescuers <span class="badge bg-info rounded-pill" style="margin-left: 5px; font-size: 0.8rem;" id="all-count">0</span>
                </div>
            </div>

            <!-- Tab 1: Connected Rescuers -->
            <div id="content-connected" class="tab-content active">
                <div class="rescuers-grid" id="rescuers-grid">
                    <!-- Cards will be injected here -->
                </div>
            </div>

            <!-- Tab 2: Ghost Rescuers -->
            <div id="content-ghosts" class="tab-content">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div style="color: var(--text-muted); font-size: 0.9rem;">
                        <i class="bi bi-info-circle"></i> Showing rescuers marked as <strong style="color:var(--accent-green)">IsOnline=true</strong> in DB but missing from SignalR Hub.
                    </div>
                    <button class="btn btn-sm" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--accent-red); color: var(--accent-red); transition: all 0.2s;" onclick="scanGhosts()" onmouseover="this.style.background='rgba(239, 68, 68, 0.2)'" onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'">
                        <i class="bi bi-radar"></i> Rescan Ghosts
                    </button>
                </div>
                
                <div class="rescuers-grid" id="ghost-grid">
                    <div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 40px; border: 1px dashed var(--border-color); border-radius: 12px;">
                        Click "Rescan Ghosts" to find disconnected sessions.
                    </div>
                </div>
            </div>

            <!-- Tab 3: All Rescuers -->
            <div id="content-all" class="tab-content">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div style="color: var(--text-muted); font-size: 0.9rem;">
                        <i class="bi bi-info-circle"></i> Showing all rescuers registered in the system database. Let you see who is offline.
                    </div>
                    <button class="btn btn-sm" style="background: rgba(56, 189, 248, 0.1); border: 1px solid var(--accent-blue); color: var(--accent-blue); transition: all 0.2s;" onclick="fetchAllRescuers()" onmouseover="this.style.background='rgba(56, 189, 248, 0.2)'" onmouseout="this.style.background='rgba(56, 189, 248, 0.1)'">
                        <i class="bi bi-arrow-clockwise"></i> Refresh All
                    </button>
                </div>
                <div class="rescuers-grid" id="all-grid">
                    <!-- All cards will be injected here -->
                </div>
            </div>
        </div>

        <!-- Sidebar Area: Tracker & Console -->
        <div class="sidebar-area">
            <div class="incident-tracker" id="incident-tracker" style="display: none;">
                <div class="incident-title"><i class="bi bi-exclamation-triangle-fill"></i> ACTIVE SOS DETECTED</div>
                <div class="incident-detail">
                    <span>Incident ID:</span> <strong id="track-incident-id">-</strong>
                </div>
                <div class="incident-detail">
                    <span>Session ID:</span> <strong id="track-session-id">-</strong>
                </div>
                <div class="incident-detail">
                    <span>Radius Level:</span> <strong id="track-radius">- km</strong>
                </div>
                
                <div class="timer-container">
                    <div class="timer-header">
                        <span>Time Remaining</span>
                        <span class="time" id="countdown-text">60s</span>
                    </div>
                    <div class="progress-custom">
                        <div id="countdown-bar" class="progress-bar-custom" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <div class="event-console" id="event-console">
                <div class="console-header"><i class="bi bi-terminal"></i> System Event Log</div>
                <div class="console-entry info"><span class="time">[System]</span> Initializing connection...</div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const adminToken = '@Model.AdminToken';
        const rescuersGrid = document.getElementById('rescuers-grid');
        const ghostGrid = document.getElementById('ghost-grid');
        const allGrid = document.getElementById('all-grid');
        const eventConsole = document.getElementById('event-console');
        const rescuerCount = document.getElementById('rescuer-count');
        const ghostCount = document.getElementById('ghost-count');
        const allCount = document.getElementById('all-count');
        const connectionStatus = document.getElementById('connection-status');
        
        function switchTab(tabName) {
            // Hide all contents
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.custom-tab').forEach(el => el.classList.remove('active'));
            
            // Show selected
            document.getElementById(`content-${tabName}`).classList.add('active');
            document.getElementById(`tab-${tabName}`).classList.add('active');

            if (tabName === 'ghosts' && ghostCount.innerText === '0') scanGhosts();
            if (tabName === 'all' && allCount.innerText === '0') fetchAllRescuers();
        }
        
        let connectedRescuers = {}; // { id: { timerInterval: num, secondsSincePing: num } }
        let countdownTimer = null;
        let timeLeft = 60;

        function startPingTimer(id) {
            if (!connectedRescuers[id]) return;
            
            // Clear existing timer
            if (connectedRescuers[id].timerInterval) {
                clearInterval(connectedRescuers[id].timerInterval);
            }
            
            connectedRescuers[id].secondsSincePing = 0;
            const timerEl = document.getElementById(`ping-${id}`);
            if (timerEl) {
                timerEl.classList.remove('stale');
                timerEl.style.setProperty('--ping-progress', '0%');
            }

            // Capture the interval ID in a local closure so clearInterval still works
            // even if connectedRescuers[id] is deleted by removeRescuerCard.
            const intervalId = setInterval(() => {
                if (!connectedRescuers[id]) {
                    // Rescuer was removed; clean up this orphaned interval.
                    clearInterval(intervalId);
                    return;
                }
                
                connectedRescuers[id].secondsSincePing++;
                const sec = connectedRescuers[id].secondsSincePing;
                const el = document.getElementById(`ping-${id}`);
                
                if (el) {
                    if (sec <= 10) {
                        // 10s is the flutter geolocator target. 360deg / 10s = 36% per sec roughly, 100% at 10s.
                        el.style.setProperty('--ping-progress', `${(sec / 10) * 100}%`);
                    } else {
                        // Time exceeded 10s. Likely Flutter stationary optimization (<10m).
                        el.classList.add('stale');
                        clearInterval(intervalId);
                    }
                }
            }, 1000);
            connectedRescuers[id].timerInterval = intervalId;
        }

        function logEvent(message, type = 'info') {
            const time = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute:'2-digit', second:'2-digit' });
            const el = document.createElement('div');
            el.className = `console-entry ${type}`;
            el.innerHTML = `<span class="time">[${time}]</span> ${message}`;
            eventConsole.appendChild(el);
            eventConsole.scrollTop = eventConsole.scrollHeight;
        }

        // Upgrade an existing placeholder card with richer rescuer data (fullName, avatar, stats).
        function updateRescuerCard(id, rescuer) {
            if (typeof rescuer === 'string') return; // Only a plain ID — no richer data to apply
            const card = document.getElementById(`card-${id}`);
            if (!card) return;

            const shortId = id.substring(0, 8);
            const name = rescuer.fullName || `Rescuer ${shortId}...`;
            const avatar = rescuer.avatarUrl
                ? `<img src="${rescuer.avatarUrl}" style="width:100%; height:100%; border-radius:12px; object-fit:cover;" />`
                : name.substring(0, 2).toUpperCase();
            const type = rescuer.type || "Unknown";
            const rating = rescuer.rating ? rescuer.rating.toFixed(1) : "0.0";
            const missions = rescuer.totalMissions !== undefined ? rescuer.totalMissions : 0;

            // Update name/avatar row
            const avatarEl = card.querySelector('.rescuer-avatar');
            if (avatarEl) avatarEl.innerHTML = avatar;
            const h5 = card.querySelector('h5');
            if (h5) h5.innerText = name;
            const subtitle = card.querySelector('h5 + div');
            if (subtitle) subtitle.innerHTML = `${type} &bull; ⭐ ${rating} &bull; 🚑 ${missions}`;

            // Update IsOnline pill
            const isOnlinePill = card.querySelector(`[id^="status-"] ~ div:last-of-type`);
            if (rescuer.isOnline !== undefined) {
                const color = rescuer.isOnline ? 'var(--accent-green)' : 'var(--accent-red)';
                const bg = rescuer.isOnline ? 'rgba(16, 185, 129, 0.1)' : 'rgba(239, 68, 68, 0.1)';
                if (isOnlinePill) {
                    isOnlinePill.style.borderColor = color;
                    isOnlinePill.style.backgroundColor = bg;
                    const icon = isOnlinePill.querySelector('i');
                    const span = isOnlinePill.querySelector('span');
                    if (icon) icon.style.color = color;
                    if (span) span.style.color = color;
                }
            }
        }

        function createRescuerCard(rescuer) {
            // Support fallback if only ID is provided (e.g., from early location update)
            const id = typeof rescuer === 'string' ? rescuer : rescuer.id;
            if (!id) return;

            // If a card already exists, upgrade it with any richer data instead of returning early.
            // This lets placeholder cards (created from LocationUpdated with just an id string)
            // get populated when AdminLog/RescuerJoined later delivers the full object.
            if (document.getElementById(`card-${id}`)) {
                updateRescuerCard(id, rescuer);
                return;
            }

            const shortId = id.substring(0, 8);
            const name = rescuer.fullName || `Rescuer ${shortId}...`;
            const avatar = rescuer.avatarUrl 
                 ? `<img src="${rescuer.avatarUrl}" style="width:100%; height:100%; border-radius:12px; object-fit:cover;" />` 
                 : name.substring(0, 2).toUpperCase();
            
            const type = rescuer.type || "Unknown";
            const rating = rescuer.rating ? rescuer.rating.toFixed(1) : "0.0";
            const missions = rescuer.totalMissions !== undefined ? rescuer.totalMissions : 0;

            const card = document.createElement('div');
            card.className = 'rescuer-card';
            card.id = `card-${id}`;
            card.innerHTML = `
                <!-- Row 1: Profile & Ping Timer -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <div class="rescuer-avatar" style="width: 42px; height: 42px; font-size: 1rem;">${avatar}</div>
                        <div>
                            <h5 style="margin: 0; font-size: 1rem; font-weight: 600;">${name}</h5>
                            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                                ${type} &bull; ⭐ ${rating} &bull; 🚑 ${missions}
                            </div>
                        </div>
                    </div>
                    <div class="ping-timer" id="ping-${id}" title="10s ping interval">
                        <i class="bi bi-clock"></i>
                    </div>
                </div>

                <!-- Row 2: Status & System Connections -->
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; align-items: center;">
                    <div class="status-badge idle" id="status-${id}" style="margin: 0;">IDLE</div>
                    <div class="loc-pill" style="border-color: var(--accent-green); background-color: rgba(16, 185, 129, 0.1); padding: 4px 10px;">
                        <i class="bi bi-broadcast" style="color: var(--accent-green);"></i> <span style="color: var(--accent-green);">SignalR</span>
                    </div>
                    <div class="loc-pill" style="border-color: ${rescuer.isOnline ? 'var(--accent-green)' : 'var(--accent-red)'}; background-color: ${rescuer.isOnline ? 'rgba(16, 185, 129, 0.1)' : 'rgba(239, 68, 68, 0.1)'}; padding: 4px 10px;">
                        <i class="bi bi-database" style="color: ${rescuer.isOnline ? 'var(--accent-green)' : 'var(--accent-red)'};"></i> <span style="color: ${rescuer.isOnline ? 'var(--accent-green)' : 'var(--accent-red)'}">IsOnline</span>
                    </div>
                </div>

                <!-- Row 3: Live Location -->
                <div class="location-pills" id="loc-${id}" style="margin-top: 0; padding-top: 12px; border-top: 1px dashed rgba(255,255,255,0.05); gap: 8px;">
                    <div class="loc-pill" style="padding: 4px 10px;">Lat <span>--</span></div>
                    <div class="loc-pill" style="padding: 4px 10px;">Lng <span>--</span></div>
                </div>
            `;
            rescuersGrid.appendChild(card);
            connectedRescuers[id] = { timerInterval: null, secondsSincePing: 0 };
            updateCount();
            startPingTimer(id); // Start virtual timer
        }

        function removeRescuerCard(id) {
            const card = document.getElementById(`card-${id}`);
            if (card) {
                if (connectedRescuers[id] && connectedRescuers[id].timerInterval) {
                    clearInterval(connectedRescuers[id].timerInterval);
                }
                card.style.opacity = '0';
                card.style.transform = 'scale(0.9)';
                setTimeout(() => {
                    card.remove();
                    delete connectedRescuers[id];
                    updateCount();
                }, 300);
            }
        }

        function updateCount() {
            rescuerCount.innerText = Object.keys(connectedRescuers).length;
        }

        function getShortId(guid) {
            if (!guid) return "Unknown";
            return guid.substring(0, 8);
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/rescuer-hub", { accessTokenFactory: () => adminToken })
            .withAutomaticReconnect()
            .build();

        // Re-join Monitor group after automatic reconnect so the dashboard keeps receiving events.
        connection.onreconnected(async () => {
            logEvent("SignalR reconnected. Re-joining Monitor group...", "warn");
            try {
                await connection.invoke("JoinAsMonitor");
                logEvent("Successfully re-joined Monitor group after reconnect.", "success");
            } catch (err) {
                logEvent(`Failed to re-join Monitor group: ${err.toString()}`, "error");
            }
        });

        connection.on("ConnectedRescuers", (data) => {
            logEvent(`Synchronized ${data.count} active rescuers from Hub.`, 'success');
            rescuersGrid.innerHTML = '';
            connectedRescuers = {};
            if (data.rescuers) {
                data.rescuers.forEach(r => createRescuerCard(r));
            }
        });

        async function scanGhosts() {
            logEvent("Scanning for ghost rescuers via API...", "warn");
            try {
                const response = await fetch('?handler=Ghosts');
                if(!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                
                logEvent(`Ghost scan complete: Found ${data.count} ghosts in DB.`, data.count > 0 ? "error" : "success");
                
                ghostCount.innerText = data.count;
                ghostGrid.innerHTML = '';
                
                if(data.count === 0) {
                    ghostGrid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: var(--accent-green); padding: 40px; border: 1px dashed rgba(16, 185, 129, 0.3); border-radius: 12px; background: rgba(16, 185, 129, 0.05);">✅ No ghosts detected in database. All states synchronized.</div>';
                    return;
                }

                data.rescuers.forEach(r => {
                    const id = r.id;
                    const shortId = id.substring(0, 8);
                    const name = r.fullName || `Rescuer ${shortId}...`;
                    const avatar = r.avatarUrl 
                         ? `<img src="${r.avatarUrl}" style="width:100%; height:100%; border-radius:12px; object-fit:cover;" />` 
                         : name.substring(0, 2).toUpperCase();
                    
                    const type = r.type || "Unknown";
                    
                    const card = document.createElement('div');
                    card.className = 'rescuer-card';
                    card.style.borderColor = 'rgba(239, 68, 68, 0.5)';
                    card.style.background = 'rgba(239, 68, 68, 0.05)';
                    card.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <div style="display: flex; gap: 12px; align-items: center;">
                                <div class="rescuer-avatar" style="width: 42px; height: 42px; font-size: 1rem; background: var(--border-color);">${avatar}</div>
                                <div>
                                    <h5 style="margin: 0; font-size: 1rem; font-weight: 600; color: var(--accent-red);">${name}</h5>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                                        ${type} &bull; Mismatched DB State
                                    </div>
                                </div>
                            </div>
                            <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red); font-size: 1.2rem;"></i>
                        </div>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                            <div class="loc-pill" style="border-color: var(--accent-red); background-color: rgba(239, 68, 68, 0.1); padding: 4px 10px;">
                                <i class="bi bi-broadcast" style="color: var(--accent-red);"></i> <span style="text-decoration: line-through; color: var(--text-muted);">SignalR</span>
                            </div>
                            <div class="loc-pill" style="border-color: var(--accent-green); background-color: rgba(16, 185, 129, 0.1); padding: 4px 10px;">
                                <i class="bi bi-database" style="color: var(--accent-green);"></i> <span style="color: var(--accent-green);">IsOnline</span>
                            </div>
                        </div>
                    `;
                    ghostGrid.appendChild(card);
                });
            } catch (err) {
                logEvent(`Scan failed: ${err.message}`, "error");
            }
        }

        async function fetchAllRescuers() {
            logEvent("Fetching all rescuers from DB...", "info");
            try {
                const response = await fetch('?handler=AllRescuers');
                if(!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                
                logEvent(`Full Database sync: ${data.count} rescuers loaded.`, "info");
                allCount.innerText = data.count;
                allGrid.innerHTML = '';
                
                if(data.rescuers) {
                    data.rescuers.forEach(r => {
                        const id = r.id;
                        const shortId = id.substring(0, 8);
                        const name = r.fullName || `Rescuer ${shortId}...`;
                        const avatar = r.avatarUrl 
                             ? `<img src="${r.avatarUrl}" style="width:100%; height:100%; border-radius:12px; object-fit:cover;" />` 
                             : name.substring(0, 2).toUpperCase();
                        
                        const type = r.type || "Unknown";
                        
                        // See if they're also connected right now
                        const isSignalR = connectedRescuers[id] ? true : false;
                        
                        const card = document.createElement('div');
                        card.className = 'rescuer-card';
                        // Dim offline rescuers
                        if (!r.isOnline && !isSignalR) {
                            card.style.opacity = '0.7';
                            card.style.filter = 'grayscale(1)';
                        }
                        card.innerHTML = `
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                <div style="display: flex; gap: 12px; align-items: center;">
                                    <div class="rescuer-avatar" style="width: 42px; height: 42px; font-size: 1rem; background: var(--border-color);">${avatar}</div>
                                    <div>
                                        <h5 style="margin: 0; font-size: 1rem; font-weight: 600;">${name}</h5>
                                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                                            ${type} &bull; DB Record
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                                <div class="loc-pill" style="border-color: ${isSignalR ? 'var(--accent-green)' : 'rgba(255,255,255,0.1)'}; background-color: ${isSignalR ? 'rgba(16, 185, 129, 0.1)' : 'rgba(255, 255, 255, 0.05)'}; padding: 4px 10px;">
                                    <i class="bi bi-broadcast" style="color: ${isSignalR ? 'var(--accent-green)' : 'var(--text-muted)'};"></i> <span style="color: ${isSignalR ? 'var(--accent-green)' : 'var(--text-muted)'};">SignalR</span>
                                </div>
                                <div class="loc-pill" style="border-color: ${r.isOnline ? 'var(--accent-green)' : 'rgba(255,255,255,0.1)'}; background-color: ${r.isOnline ? 'rgba(16, 185, 129, 0.1)' : 'rgba(255, 255, 255, 0.05)'}; padding: 4px 10px;">
                                    <i class="bi bi-database" style="color: ${r.isOnline ? 'var(--accent-green)' : 'var(--text-muted)'};"></i> <span style="color: ${r.isOnline ? 'var(--accent-green)' : 'var(--text-muted)'};">IsOnline</span>
                                </div>
                            </div>
                        `;
                        allGrid.appendChild(card);
                    });
                }
            } catch (err) {
                logEvent(`Failed to fetch all rescuers: ${err.message}`, "error");
            }
        }

        connection.on("AdminLog", (data) => {
            let logType = 'info';
            if (data.type === 'RescuerJoined') {
                createRescuerCard(data.rescuer || data.userId);
                logType = 'success';
            } else if (data.type === 'RescuerDisconnected') {
                removeRescuerCard(data.userId);
                logType = 'warn';
            }
            logEvent(`[${data.type}] ${data.message}`, logType);
        });

        connection.on("LocationUpdated", (data) => {
            const locBox = document.getElementById(`loc-${data.userId}`);
            if(locBox) {
                locBox.innerHTML = `
                    <div class="loc-pill">Lat <span>${data.latitude.toFixed(5)}</span></div>
                    <div class="loc-pill">Lng <span>${data.longitude.toFixed(5)}</span></div>
                `;
                
                // Highlight blink effect
                locBox.classList.add('highlight');
                if(Math.random() < 0.2) logEvent(`Location ingestion OK - ID: ${getShortId(data.userId)}`, 'info'); // log 20% to prevent spam
                setTimeout(() => locBox.classList.remove('highlight'), 1000);

                // Restart Ping Timer
                startPingTimer(data.userId);

            } else {
                createRescuerCard(data.userId);
            }
        });

        connection.on("NewRescueRequest", (payload) => {
            const data = payload.data || payload; 
            logEvent(`DISPATCH: SOS Pinged to Rescuer ${getShortId(payload.rescuerId || data.requestId)}! Session: ${data.sessionId}`, 'warn');
            
            const tracker = document.getElementById('incident-tracker');
            tracker.style.display = 'block';
            tracker.style.animation = 'pulse-yellow 2s';
            
            document.getElementById('track-incident-id').innerText = getShortId(data.incidentId);
            document.getElementById('track-session-id').innerText = data.sessionId;
            document.getElementById('track-radius').innerText = `${data.radiusKm || 'Unknown'} km`;
            
            clearInterval(countdownTimer);
            timeLeft = 60;
            const bar = document.getElementById('countdown-bar');
            bar.style.transition = 'none';
            bar.style.width = '100%';
            bar.style.background = 'linear-gradient(90deg, var(--accent-red), #f43f5e)';
            
            // force reflow
            void bar.offsetWidth;
            bar.style.transition = 'width 1s linear';

            countdownTimer = setInterval(() => {
                timeLeft--;
                document.getElementById('countdown-text').innerText = `${timeLeft}s`;
                bar.style.width = `${(timeLeft/60)*100}%`;
                if(timeLeft <= 0) clearInterval(countdownTimer);
            }, 1000);

            if (payload.rescuerId) {
                const card = document.getElementById(`card-${payload.rescuerId}`);
                if (card) {
                    card.className = 'rescuer-card pinged';
                    const sb = document.getElementById(`status-${payload.rescuerId}`);
                    if(sb) { sb.className = 'status-badge pinged'; sb.innerText = 'PINGED (SOS)'; }
                }
            }
        });

        connection.on("RequestAccepted", (data) => {
            logEvent(`MATCH CONFIRMED: ${getShortId(data.rescuerId)} won the dispatch!`, 'success');
            clearInterval(countdownTimer);
            const bar = document.getElementById('countdown-bar');
            bar.style.background = 'var(--accent-green)';
            bar.style.boxShadow = '0 0 10px rgba(16, 185, 129, 0.5)';

            const card = document.getElementById(`card-${data.rescuerId}`);
            if(card) {
                card.className = 'rescuer-card winner';
                const sb = document.getElementById(`status-${data.rescuerId}`);
                if(sb) { sb.className = 'status-badge busy'; sb.innerText = 'BUSY (MISSION)'; }
            }
        });

        connection.on("RequestTaken", (data) => {
            logEvent(`RACE LOST: Rescuer ${getShortId(data.targetRescuerId)} was outpaced.`, 'warn');
            const card = document.getElementById(`card-${data.targetRescuerId}`);
            if(card) {
                card.className = 'rescuer-card taken';
                const sb = document.getElementById(`status-${data.targetRescuerId}`);
                if(sb) { sb.className = 'status-badge idle'; sb.innerText = 'IDLE'; }
            }
        });

        connection.on("RequestExpired", (data) => {
            logEvent(`TIMEOUT: Session expired for Rescuer ${getShortId(data.targetRescuerId)}.`, 'error');
            const card = document.getElementById(`card-${data.targetRescuerId}`);
            if (card) {
                card.className = 'rescuer-card';
                const sb = document.getElementById(`status-${data.targetRescuerId}`);
                if(sb) { sb.className = 'status-badge idle'; sb.innerText = 'IDLE'; }
            }
            clearInterval(countdownTimer);
            document.getElementById('countdown-bar').style.width = '0%';
        });

        connection.on("RequestCancelled", (data) => {
            logEvent(`ABORTED: Victim cancelled Request ${data.requestId}`, 'error');
            clearInterval(countdownTimer);
            document.getElementById('incident-tracker').style.display = 'none';
            document.querySelectorAll('.rescuer-card.pinged').forEach(el => {
                el.className = 'rescuer-card';
                const id = el.id.replace('card-', '');
                const sb = document.getElementById(`status-${id}`);
                if(sb) { sb.className = 'status-badge idle'; sb.innerText = 'IDLE'; }
            });
        });

        async function start() {
            try {
                await connection.start();
                connectionStatus.innerText = "CONNECTED";
                logEvent("SignalR Connection established. Entering Monitor God Mode.", "success");
                
                await connection.invoke("JoinAsMonitor");
                
                // Fetch initial data for tabs after connecting
                scanGhosts();
                fetchAllRescuers();
            } catch (err) {
                logEvent(`Connection Error: ${err.toString()}`, "error");
                connectionStatus.innerText = 'Disconnected';
                connectionStatus.className = 'badge badge-status disconnected';
                setTimeout(start, 5000);
            }
        }

        connection.onclose(() => {
            connectionStatus.innerText = 'Disconnected';
            connectionStatus.className = 'badge badge-status disconnected';
            logEvent("Connection lost. Reconnecting...", "warn");
        });

        start();
    </script>
</body>
</html>
